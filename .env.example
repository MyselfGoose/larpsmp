# LarpSMP secrets — copy to .env and share that file with the team.
#   cp .env.example .env
#
# .env is gitignored. .env.example is the committed template.
# Priority: process environment > .env file > config.yml fallbacks.

# ---------------------------------------------------------------------------
# PostgreSQL (Docker Compose + plugin JDBC)
# ---------------------------------------------------------------------------
LARPSMP_POSTGRES_DB=larpsmp
LARPSMP_POSTGRES_USER=larpsmp
LARPSMP_POSTGRES_PASSWORD=larpsmp
LARPSMP_POSTGRES_HOST=127.0.0.1
LARPSMP_POSTGRES_PORT=5433

# Full JDBC URL used by the Paper plugin (and integration tests).
LARPSMP_JDBC_URL=jdbc:postgresql://127.0.0.1:5433/larpsmp

# Credentials the plugin uses to connect (usually same as POSTGRES_* locally).
LARPSMP_DB_USER=larpsmp
LARPSMP_DB_PASSWORD=larpsmp

# HikariCP pool size (optional; config.yml default is 5).
LARPSMP_DB_POOL_SIZE=5

# ---------------------------------------------------------------------------
# pgAdmin
# ---------------------------------------------------------------------------
LARPSMP_PGADMIN_EMAIL=admin@larpsmp.dev
LARPSMP_PGADMIN_PASSWORD=admin
LARPSMP_PGADMIN_PORT=5050

# ---------------------------------------------------------------------------
# Email (Resend) — required for signup verification and account recovery
# ---------------------------------------------------------------------------
# API key from https://resend.com
LARPSMP_RESEND_API_KEY=
# Must be a sender Resend allows.
# - Verified domain (recommended): e.g. noreply@yourdomain.com — can email any recipient.
# - Sandbox onboarding@resend.dev: can ONLY email the Resend account owner's address.
LARPSMP_RESEND_FROM_EMAIL=
# Optional pepper for hashing email verification codes (defaults derived from API key).
LARPSMP_EMAIL_CODE_PEPPER=

# ---------------------------------------------------------------------------
# Remote storage / object API — fill when wiring uploads
# ---------------------------------------------------------------------------
LARPSMP_STORAGE_BASE_URL=
LARPSMP_STORAGE_API_KEY=
